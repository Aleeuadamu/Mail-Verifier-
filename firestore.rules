rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adamu0533@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /community_reports/{reportId} {
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.auth != null && request.resource.data.status == 'pending_review';
      allow update, delete: if isAdmin();
    }
  }
}

