{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "subscription": {
          "type": "object",
          "properties": {
            "plan": {
              "type": "string"
            },
            "usage": {
              "type": "integer"
            },
            "paymentMethod": {
              "type": "string"
            },
            "currentPeriodEnd": {
              "type": "string"
            },
            "invoices": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "User"
      },
      "description": "User profiles"
    }
  }
}
